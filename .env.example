# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
# .env.local is gitignored — never commit real keys.

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Bypasses RLS entirely — server-side only, never NEXT_PUBLIC_.
# Two routes need it because their callers have no session to act as: the
# capture endpoint (an iOS Shortcut holding a bearer token) and the price cron
# (a scheduled job acting for nobody). Nothing else should ever reach for it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (R2 > Manage API Tokens) --------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitr
# Public read URL for the bucket: either the r2.dev dev subdomain or a custom domain.
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev

# --- Gemini (Phase 1+; not needed to boot) ---------------------------------
# https://aistudio.google.com/apikey
# Without this, intake still works — items save untagged and you fill in the
# category yourself in the review grid.
GEMINI_API_KEY=
# Optional. Google renames and retires these regularly and which ones a key may
# call for free changes independently, so it's a variable rather than a constant.
# A 404 from the tagger means this model isn't available to your key.
GEMINI_MODEL=gemini-3.6-flash

# --- Price watch cron (Phase 6) --------------------------------------------
# The shared secret GitHub Actions presents to /api/cron/prices. That route has
# no session behind it, so this is the only thing between a scheduled job and
# anyone who guesses the path. Any long random string:
#   openssl rand -base64 32
# Set the identical value as a repository secret named CRON_SECRET.
CRON_SECRET=

# --- Web Push (Phase 6, optional) ------------------------------------------
# Price drops land on /watch whether or not these are set. They only add the
# notification. Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key ships to the browser (that's what lets it subscribe); the
# private key signs the push and must not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for the push services, so they can reach you if your
# notifications start misbehaving. mailto: or an https URL.
VAPID_SUBJECT=mailto:you@example.com
