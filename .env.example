# Copy to .env.local and fill in. See SETUP.md for where each value comes from.
# .env.local is gitignored — never commit real keys.

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (R2 > Manage API Tokens) --------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitr
# Public read URL for the bucket: either the r2.dev dev subdomain or a custom domain.
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev

# --- Gemini (Phase 1+; not needed to boot) ---------------------------------
# https://aistudio.google.com/apikey
# Without this, intake still works — items save untagged and you fill in the
# category yourself in the review grid.
GEMINI_API_KEY=
# Optional. Google renames and retires these regularly and which ones a key may
# call for free changes independently, so it's a variable rather than a constant.
# A 404 from the tagger means this model isn't available to your key.
GEMINI_MODEL=gemini-3.6-flash
