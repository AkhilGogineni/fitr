# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
# ...but the template carries no secrets and must be committed.
!.env.example

# vercel
.vercel

# graphify — regenerable from source via `graphify update .`, so it's noise in
# diffs. (Graphify ships a git merge driver for graph.json if you ever decide
# you'd rather commit it.)
graphify-out/

# typescript
*.tsbuildinfo
next-env.d.ts
